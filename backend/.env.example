# Copy to .env and edit. For a quick demo with no database, leave MONGO_URL=mock.
MONGO_URL=mock          # mock = in-memory demo database. For real use: mongodb://USER:PASSWORD@localhost:27017/?authSource=admin

DB_NAME=medismart
JWT_SECRET=          # REQUIRED when DEV_MODE=0: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# DEV_MODE=1 returns OTPs in API responses (demo). MUST be 0 in production.
DEV_MODE=1
SEED_DEMO=1
ADMIN_EMAIL=            # your admin e-mail (required for first-run admin)
ADMIN_PASSWORD=         # leave empty to get a random one-time password in the server log
CORS_ORIGINS=http://localhost:5173
APP_TZ=Asia/Kolkata
# Optional delivery channels
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WA_FROM=
# Optional LLM chatbot (Anthropic API key); without it the rule-based assistant is used
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Telemedicine (WebRTC)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TELE_ANYTIME=1

# Server-side speech-to-text (optional): Whisper API (OpenAI-compatible) and/or Bhashini
STT_PROVIDER=auto
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Second opinion LLM method (optional) - same key the chatbot uses
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# Demo data (SEED_DEMO=1): accounts are patient@<domain>, doctor1..6@<domain>, pharmacist@<domain>
DEMO_EMAIL_DOMAIN=
DEMO_PASSWORD=          # empty -> random, printed once in the server log

# --- Google Cloud (optional) ---
# Database: create a free MongoDB Atlas cluster on Google Cloud and paste its connection string as MONGO_URL
#   (mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority). Add your IP in Atlas Network Access.
# Files: create a private Cloud Storage bucket, set its name here, and authenticate with
#   GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json (role: Storage Object Admin on that bucket only).
GCS_BUCKET=

# Contact page (optional)
SUPPORT_EMAIL=
SUPPORT_PHONE=
# WhatsApp number with country code, digits only, e.g. 919876543210 (adds a WhatsApp button to the Contact page)
SUPPORT_WHATSAPP=
